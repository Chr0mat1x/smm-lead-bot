# --- Telegram Bot API (обязательно) ---
# Получите у @BotFather
TELEGRAM_BOT_TOKEN=

# Кто имеет доступ к боту: ваши Telegram user id через запятую.
# Узнать свой id можно у @userinfobot. Пусто = бот открыт любому, кто его найдёт.
ALLOWED_USER_IDS=

# --- Telethon (только для полуручной отправки, необязательно) ---
# Получите на https://my.telegram.org -> API development tools
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# --- Ваше предложение ---
YOUR_NAME=Александр
YOUR_CONTACT=@ваш_ник

# --- Лимиты безопасности ---
DAILY_SEND_LIMIT=15
MIN_SECONDS_BETWEEN_SENDS=120

DB_PATH=data/leads.sqlite3

# --- Нейросеть для диалога ---
# По умолчанию — бесплатно и без ключа:
#   LLM_PROVIDER=pollinations
# Минус этого варианта: сервис публичный, отвечает от 0.3 до 60 секунд и
# иногда отдаёт 5xx. Бот переживает это (повторы, запасные команды), но если
# раздражает медлительность — возьмите Groq: ключ бесплатный, ответ мгновенный.
#   LLM_PROVIDER=openai
#   LLM_BASE_URL=https://api.groq.com/openai/v1
#   LLM_API_KEY=gsk_...
#   LLM_MODEL=llama-3.3-70b-versatile
# Ниже — варианты с ключом, если нужна стабильность.
# Вариант 1: OpenAI
#   LLM_PROVIDER=openai
#   LLM_API_KEY=sk-...
#   LLM_MODEL=gpt-4o-mini
# Вариант 2: OpenRouter (много моделей, дешевле)
#   LLM_PROVIDER=openai
#   LLM_BASE_URL=https://openrouter.ai/api/v1
#   LLM_API_KEY=sk-or-...
#   LLM_MODEL=anthropic/claude-3.5-sonnet
# Вариант 3: Groq (быстро и бесплатно на старте)
#   LLM_PROVIDER=openai
#   LLM_BASE_URL=https://api.groq.com/openai/v1
#   LLM_API_KEY=gsk_...
#   LLM_MODEL=llama-3.3-70b-versatile
# Вариант 4: Claude напрямую
#   LLM_PROVIDER=anthropic
#   LLM_API_KEY=sk-ant-...
#   LLM_MODEL=claude-3-5-sonnet-latest
# Вариант 5: локально через Ollama (ключ не нужен)
#   LLM_PROVIDER=openai
#   LLM_BASE_URL=http://localhost:11434/v1
#   LLM_API_KEY=ollama
#   LLM_MODEL=llama3.1
LLM_PROVIDER=pollinations
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=
LLM_TEMPERATURE=0.7
