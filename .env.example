# --- Telegram Bot API (обязательно) ---
# Получите у @BotFather
TELEGRAM_BOT_TOKEN=

# Кто имеет доступ к боту: ваши Telegram user id через запятую.
# Узнать свой id можно у @userinfobot. Пусто = бот открыт любому, кто его найдёт.
ALLOWED_USER_IDS=

# --- Telethon (только для полуручной отправки, необязательно) ---
# Получите на https://my.telegram.org -> API development tools
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# --- Ваше предложение ---
YOUR_NAME=Александр
YOUR_CONTACT=@ваш_ник

# --- Лимиты безопасности ---
DAILY_SEND_LIMIT=15
MIN_SECONDS_BETWEEN_SENDS=120

DB_PATH=data/leads.sqlite3
